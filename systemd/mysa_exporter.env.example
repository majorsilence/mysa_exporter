# Copy to /etc/mysa_exporter.env, fill in your credentials, then:
#   sudo chown root:mysa_exporter /etc/mysa_exporter.env
#   sudo chmod 640 /etc/mysa_exporter.env
MYSA_USERNAME=you@example.com
MYSA_PASSWORD=your-mysa-password

# Optional -- these match the exporter's own defaults.
#MYSA_EXPORTER_LISTEN_ADDRESS=127.0.0.1
#MYSA_EXPORTER_PORT=9499
#MYSA_EXPORTER_POLL_INTERVAL_SECONDS=60
